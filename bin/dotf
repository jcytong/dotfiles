#!/bin/bash
set -e

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
FILES_DIR="$DOTFILES_DIR/files/home"

# Directories to symlink as a whole (not file-by-file).
DIR_LINKS=".agents/skills"

# Coding-agent skill directories that should receive one link per public skill.
# Add a home-relative skills directory here when another CLI should share these
# skills. The vendor-neutral .agents root is the single source of truth; every
# per-agent root below is generated from it.
#
# Only agents with a hardcoded skills path need a mirror here. An agent that can
# be pointed at a directory (pi, via ~/.pi/settings.json) should read the
# canonical root directly instead, or it loads every skill once per mirror.
SHARED_SKILL_LINK_TARGETS=".claude/skills .codex/skills"

# Instruction files composed from a shared core plus a per-agent overlay, as
# "<home-relative target>:<overlay name>". The overlay may be absent or empty.
#
# These are generated rather than linked because no agent can compose them at
# read time: codex has no import mechanism, and Claude's @import expands only
# when CLAUDE.md is a real file — it silently stops when the file is a symlink,
# which is how every other dotfile here is deployed. Verified empirically.
#
# pi is deliberately absent: it reads AGENTS.md/CLAUDE.md by walking up from the
# working directory and ignores ~/.pi/AGENTS.md, so a global file would be inert.
INSTRUCTION_CORE=".agents/AGENTS.md"
INSTRUCTION_OVERLAY_DIR=".agents/overlays"
COMPOSED_INSTRUCTIONS=".claude/CLAUDE.md:claude .codex/AGENTS.md:codex"
GENERATED_HEADER="<!-- generated by bin/dotf - edit files/home/.agents/AGENTS.md or files/home/.agents/overlays/ -->"

MODE="link"
VERIFY_FAILURES=0

path_exists() {
  [ -e "$1" ] || [ -L "$1" ]
}

normalize_path() {
  path="$1"
  normalized=""
  old_ifs="$IFS"
  IFS=/
  set -- $path
  IFS="$old_ifs"

  for component in "$@"; do
    case "$component" in
      ""|.)
        ;;
      ..)
        case "$normalized" in
          */*) normalized="${normalized%/*}";;
          *) normalized="";;
        esac
        ;;
      *) normalized="$normalized/$component";;
    esac
  done

  [ -n "$normalized" ] || normalized="/"
  printf '%s\n' "$normalized"
}

canonical_skill_source() {
  source_skill="$1"

  if [ -L "$source_skill" ]; then
    source_link="$(readlink "$source_skill")"
    case "$source_link" in
      /*) printf '%s\n' "$source_link";;
      *) normalize_path "$(dirname "$source_skill")/$source_link";;
    esac
  else
    printf '%s\n' "$source_skill"
  fi
}

verify_failure() {
  echo "Mismatch: $1"
  VERIFY_FAILURES=$((VERIFY_FAILURES + 1))
}

ensure_parent_directory() {
  parent="$1"

  [ -d "$parent" ] && return 0

  if [ "$MODE" = "verify" ]; then
    verify_failure "missing parent directory $parent"
  elif [ "$MODE" = "dry-run" ]; then
    echo "Would create directory $parent"
  else
    mkdir -p "$parent"
  fi
}

ensure_symlink() {
  source="$1"
  target="$2"
  description="$3"

  if [ -L "$target" ]; then
    current="$(readlink "$target")"
    if [ "$current" = "$source" ]; then
      [ "$MODE" = "verify" ] && echo "OK: $description"
      return 0
    fi

    if [ "$MODE" = "verify" ]; then
      verify_failure "$description points to $current (expected $source)"
      return 0
    fi

    if [ "$MODE" = "dry-run" ]; then
      echo "Would replace symlink $target ($current)"
      return 0
    fi

    # This is deliberately only called after -L: never recursively remove a
    # directory that the installer does not own.
    rm "$target"
  elif path_exists "$target"; then
    if [ "$MODE" = "verify" ]; then
      verify_failure "$description is not a symlink; left unchanged"
    else
      echo "Skipping $target (existing non-symlink left unchanged)"
    fi
    return 0
  fi

  ensure_parent_directory "$(dirname "$target")"

  if [ "$MODE" = "verify" ]; then
    verify_failure "missing $description"
  elif [ "$MODE" = "dry-run" ]; then
    echo "Would link $target -> $source"
  else
    ln -s "$source" "$target"
    echo "Linked $target -> $source"
  fi
}

link_directories() {
  for dir in $DIR_LINKS; do
    source="$FILES_DIR/$dir"
    target="$HOME/$dir"
    [ -d "$source" ] || continue

    if [ -L "$target" ]; then
      ensure_symlink "$source" "$target" "$dir directory"
    elif path_exists "$target"; then
      if [ "$MODE" = "verify" ]; then
        verify_failure "$dir directory is not a symlink; left unchanged"
      else
        echo "Skipping $target (existing non-symlink directory left unchanged)"
      fi
    else
      ensure_symlink "$source" "$target" "$dir directory"
    fi
  done
}

link_files() {
  # Link ordinary files, skipping paths handled as whole directories above.
  while IFS= read -r -d '' file; do
    relative="${file#$FILES_DIR/}"

    skip=false
    for dir in $DIR_LINKS; do
      case "$relative" in
        "$dir/"*) skip=true; break;;
      esac
    done
    $skip && continue

    ensure_symlink "$file" "$HOME/$relative" "$relative"
  done < <(find "$FILES_DIR" -type f -print0)
}

ensure_agent_skill_root() {
  target_root="$1"

  if [ -L "$target_root" ]; then
    if [ "$MODE" = "verify" ]; then
      verify_failure "$target_root is itself a symlink; left unchanged"
    else
      echo "Skipping $target_root (skills root is a symlink; left unchanged)"
    fi
    return 1
  fi

  if [ -d "$target_root" ]; then
    return 0
  fi

  if path_exists "$target_root"; then
    if [ "$MODE" = "verify" ]; then
      verify_failure "$target_root exists but is not a directory"
    else
      echo "Skipping $target_root (existing non-directory left unchanged)"
    fi
    return 1
  fi

  if [ "$MODE" = "verify" ]; then
    verify_failure "missing skills root $target_root"
    return 1
  elif [ "$MODE" = "dry-run" ]; then
    echo "Would create directory $target_root"
  else
    mkdir -p "$target_root"
  fi
  return 0
}

link_shared_skills() {
  source_root="$FILES_DIR/.agents/skills"
  [ -d "$source_root" ] || return 0

  for target_root_relative in $SHARED_SKILL_LINK_TARGETS; do
    target_root="$HOME/$target_root_relative"
    ensure_agent_skill_root "$target_root" || continue

    for source_skill in "$source_root"/*; do
      # Keep broken canonical links visible to the agent: the submodule may be
      # initialized after this installer runs, and the link itself is managed.
      path_exists "$source_skill" || continue
      skill="${source_skill##*/}"
      canonical_source="$(canonical_skill_source "$source_skill")"
      ensure_symlink "$canonical_source" "$target_root/$skill" "$target_root_relative/$skill"
    done
  done
}

compose_instruction_content() {
  overlay_name="$1"
  overlay="$FILES_DIR/$INSTRUCTION_OVERLAY_DIR/$overlay_name.md"

  printf '%s\n\n' "$GENERATED_HEADER"
  cat "$FILES_DIR/$INSTRUCTION_CORE"
  if [ -s "$overlay" ]; then
    printf '\n'
    cat "$overlay"
  fi
}

compose_instructions() {
  [ -f "$FILES_DIR/$INSTRUCTION_CORE" ] || return 0

  for entry in $COMPOSED_INSTRUCTIONS; do
    target_relative="${entry%%:*}"
    overlay_name="${entry##*:}"
    target="$HOME/$target_relative"
    desired="$(compose_instruction_content "$overlay_name")"

    if [ -L "$target" ]; then
      # Left over from the pre-composition layout, when these were symlinks.
      if [ "$MODE" = "verify" ]; then
        verify_failure "$target_relative is a symlink; expected a generated file"
        continue
      fi
      if [ "$MODE" = "dry-run" ]; then
        echo "Would replace symlink $target with a generated file"
        continue
      fi
      rm "$target"
    elif [ -f "$target" ]; then
      if [ "$desired" = "$(cat "$target")" ]; then
        [ "$MODE" = "verify" ] && echo "OK: $target_relative"
        continue
      fi
      if [ "$MODE" = "verify" ]; then
        verify_failure "$target_relative is stale; regenerate with dotf link"
        continue
      fi
    elif path_exists "$target"; then
      if [ "$MODE" = "verify" ]; then
        verify_failure "$target_relative exists but is not a regular file"
      else
        echo "Skipping $target (existing non-file left unchanged)"
      fi
      continue
    elif [ "$MODE" = "verify" ]; then
      verify_failure "missing $target_relative"
      continue
    fi

    ensure_parent_directory "$(dirname "$target")"

    if [ "$MODE" = "dry-run" ]; then
      echo "Would write $target"
    else
      printf '%s\n' "$desired" > "$target"
      echo "Composed $target from $INSTRUCTION_CORE + $INSTRUCTION_OVERLAY_DIR/$overlay_name.md"
    fi
  done
}

usage() {
  echo "Usage: dotf [link|--dry-run|verify]"
  echo ""
  echo "Commands:"
  echo "  link       Symlink files from files/home/ to ~/ (default)"
  echo "  --dry-run  Show link changes without modifying ~/"
  echo "  verify     Check managed links without modifying ~/"
}

case "${1:-link}" in
  link)
    if [ "${2:-}" = "--dry-run" ]; then
      MODE="dry-run"
    elif [ -n "${2:-}" ]; then
      usage
      exit 1
    fi
    ;;
  --dry-run|dry-run)
    if [ -n "${2:-}" ]; then
      usage
      exit 1
    fi
    MODE="dry-run"
    ;;
  verify)
    if [ -n "${2:-}" ]; then
      usage
      exit 1
    fi
    MODE="verify"
    ;;
  *)
    usage
    exit 1
    ;;
esac

link_directories
link_files
link_shared_skills
compose_instructions

if [ "$MODE" = "verify" ] && [ "$VERIFY_FAILURES" -ne 0 ]; then
  echo "Verification failed: $VERIFY_FAILURES managed link(s) need attention."
  exit 1
fi
