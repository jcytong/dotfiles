[user]
	name = Johnny Tong
	email = hi@johnnytong.local
[color]
	status = auto
	diff = auto
	branch = auto
[alias]
	st = status
	ci = commit
	co = checkout
	br = branch
	unstage = reset HEAD --
	fp = "!git fetch -p; git pull"
	wip = "!git add --all; git ci -m WIP"
  wt = worktree
	unwip = "!git reset --soft HEAD~1; git unstage"
[core]
	legacyheaders = false
	editor = vim
	autocrlf = input
	excludesFile = ~/.gitignore
[init]
	defaultBranch = master
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
# Per-box settings (safe.directory for local checkouts, work identities) belong
# here, not in this file. Missing on a fresh machine is fine — git ignores an
# include whose path does not exist. Last include wins, so keep this last.
[include]
	path = ~/.gitconfig.local
